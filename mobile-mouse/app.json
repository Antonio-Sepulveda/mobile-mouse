{
  "expo": {
    "name": "mobile-mouse",
    "slug": "mobile-mouse",
    "owner": "antoniosepulveda",
    "version": "1.0.0",
    "orientation": "landscape",
    "icon": "./assets/images/icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.antoniosepulveda.mobilemouse",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "This app uses the camera to scan barcodes"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.antoniosepulveda.mobilemouse",
      "permissions": ["CAMERA"]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "manifest": {
        "name": "Mobile Mouse",
        "short_name": "MobileMouse",
        "theme_color": "#000000",
        "background_color": "#ffffff",
        "display": "standalone",
        "orientation": "landscape",
        "scope": "/mobile-mouse/",
        "start_url": "/mobile-mouse/"
      },
      "registerServiceWorker": true
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Allow $(PRODUCT_NAME) to access your device motion"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera",
          "microphonePermission": "Allow $(PRODUCT_NAME) to access your microphone",
          "recordAudioAndroid": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/mobile-mouse"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "64f51f70-4bad-4bde-b98c-8df106deaed2"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/64f51f70-4bad-4bde-b98c-8df106deaed2"
    }
  }
}
